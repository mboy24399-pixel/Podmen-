rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /users/{uid} {
      allow read, write: if request.auth != null;
    }
    
    match /tracks/{trackId} {
      allow read, write: if request.auth != null;
    }
    
    match /playlists/{playlistId} {
      allow read, write: if request.auth != null;
    }
    
    match /favorites/{uid} {
      allow read, write: if request.auth != null;
    }
    
    match /payments/{paymentId} {
      allow read, write: if request.auth != null;
    }
  }
}
