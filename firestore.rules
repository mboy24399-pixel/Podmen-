rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    
    function hasAccess() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let now = request.time;
      return userData.subscriptionActive == true || 
             now < timestamp(userData.trialEnd);
    }
    
    function isNotBlocked() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBlocked != true;
    }
    
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }
    
    match /tracks/{trackId} {
      allow read: if request.auth != null && hasAccess() && isNotBlocked();
      allow write: if isAdmin();
    }
    
    match /favorites/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    
    match /playlists/{playlistId} {
      allow read, write: if request.auth != null && 
                          request.resource.data.userId == request.auth.uid;
    }
    
    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
