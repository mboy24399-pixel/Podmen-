rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function signedIn() {
      return request.auth != null;
    }
    
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }
    
    function hasOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid) 
        && request.resource.data.role == 'user' 
        && request.resource.data.subscriptionActive == false;
      allow update: if isSelf(uid)
        && hasOnly(['displayName', 'photoURL', 'settings', 'phone', 'email'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.subscriptionActive == resource.data.subscriptionActive
        && request.resource.data.trialEnd == resource.data.trialEnd;
      allow delete: if false;
    }
    
    match /tracks/{trackId} {
      allow read: if signedIn() && resource.data.isActive == true;
      allow write: if isAdmin();
    }
    
    match /playlists/{playlistId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() 
        && request.resource.data.userId == request.auth.uid 
        && request.resource.data.trackIds is list 
        && request.resource.data.name is string;
      allow update: if signedIn() 
        && resource.data.userId == request.auth.uid 
        && request.resource.data.userId == resource.data.userId;
    }
    
    match /favorites/{uid} {
      allow read, write: if isSelf(uid) && request.resource.data.trackIds is list;
    }
    
    match /payments/{paymentId} {
      allow read, write: if false;
    }
  }
}
