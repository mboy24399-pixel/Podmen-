rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==================================================
    // HELPER FUNCTIONS
    // ==================================================

    // Check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if user is owner of a document
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Get current user's role
    function getCurrentUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Check if current user is admin
    function isAdmin() {
      return isSignedIn() && getCurrentUserRole() == "admin";
    }

    // Check if current user is blocked
    function isBlockedUser() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBlocked == true;
    }

    // Check if user exists in users collection
    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    // Check if current user is active (signed in, exists, and not blocked)
    function isActiveUser() {
      return isSignedIn() && userExists(request.auth.uid) && !isBlockedUser();
    }

    // Check if the current user is an active admin
    function isActiveAdmin() {
      return isAdmin() && !isBlockedUser();
    }

    // ==================================================
    // USERS COLLECTION
    // users/{uid}
    // ==================================================
    match /users/{uid} {

      // Create: User can create their own document during first login
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == "user"
        && request.resource.data.isBlocked == false
        && request.resource.data.isPremium == false;

      // Read: User can read their own document
      // Admin can read any user document
      allow read: if isOwner(uid) || isActiveAdmin();

      // Update: User can update only permitted fields on their own document
      // Admin can update administrative fields
      allow update: if isOwner(uid) && !isBlockedUser()
        && request.resource.data.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.isBlocked == resource.data.isBlocked
        && request.resource.data.isPremium == resource.data.isPremium
        && request.resource.data.trialStart == resource.data.trialStart
        && request.resource.data.trialEnd == resource.data.trialEnd
        && request.resource.data.premiumStart == resource.data.premiumStart
        && request.resource.data.premiumEnd == resource.data.premiumEnd
        || isActiveAdmin();

      // Delete: Only admin can delete user documents
      allow delete: if isActiveAdmin();
    }

    // ==================================================
    // TRACKS COLLECTION
    // tracks/{trackId}
    // ==================================================
    match /tracks/{trackId} {

      // Create: Only active admin can create tracks
      allow create: if isActiveAdmin()
        && request.resource.data.title is string
        && request.resource.data.audioUrl is string
        && request.resource.data.category is string
        && request.resource.data.type is string;

      // Read: Active users can read published tracks
      // Admin can read all tracks
      allow read: if isActiveAdmin()
        || (isActiveUser() && resource.data.isPublished == true);

      // Update: Only active admin can update tracks
      allow update: if isActiveAdmin();

      // Delete: Only active admin can delete tracks
      allow delete: if isActiveAdmin();
    }

    // ==================================================
    // PLAYLISTS COLLECTION
    // playlists/{playlistId}
    // ==================================================
    match /playlists/{playlistId} {

      // Create: Active user can create their own playlist
      allow create: if isActiveUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string;

      // Read: User can read their own playlists
      // Admin can read any playlist
      allow read: if isActiveAdmin()
        || (isActiveUser() && resource.data.userId == request.auth.uid);

      // Update: User can update their own playlist
      // Admin can update any playlist
      allow update: if isActiveAdmin()
        || (isActiveUser()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid);

      // Delete: User can delete their own playlist
      // Admin can delete any playlist
      allow delete: if isActiveAdmin()
        || (isActiveUser() && resource.data.userId == request.auth.uid);
    }

    // ==================================================
    // FAVORITES COLLECTION
    // favorites/{favoriteId}
    // ==================================================
    match /favorites/{favoriteId} {

      // Create: Active user can create their own favorite
      allow create: if isActiveUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.trackId is string;

      // Read: User can read their own favorites
      // Admin can read any favorite
      allow read: if isActiveAdmin()
        || (isActiveUser() && resource.data.userId == request.auth.uid);

      // Update: Users cannot modify favorites after creation
      // Admin can update favorites
      allow update: if isActiveAdmin();

      // Delete: User can delete their own favorite
      // Admin can delete any favorite
      allow delete: if isActiveAdmin()
        || (isActiveUser() && resource.data.userId == request.auth.uid);
    }

    // ==================================================
    // TRANSACTIONS COLLECTION
    // transactions/{transactionId}
    // ==================================================
    match /transactions/{transactionId} {

      // Create: Active user can create a transaction record in 'created' status
      // Admin can create transaction records for administrative purposes
      allow create: if isActiveAdmin()
        || (isActiveUser()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == "created"
          && request.resource.data.amount is number
          && request.resource.data.currency is string);

      // Read: User can read their own transactions
      // Admin can read all transactions
      allow read: if isActiveAdmin()
        || (isActiveUser() && resource.data.userId == request.auth.uid);

      // Update: Normal users CANNOT update transactions
      // Only admin can update transactions
      // This prevents users from marking transactions as paid
      allow update: if isActiveAdmin();

      // Delete: Only admin can delete transactions
      allow delete: if isActiveAdmin();
    }

    // ==================================================
    // SETTINGS COLLECTION
    // settings/{uid}
    // ==================================================
    match /settings/{uid} {

      // Create: Active user can create their own settings
      allow create: if isActiveUser()
        && request.auth.uid == uid
        && request.resource.data.userId == request.auth.uid;

      // Read: User can read their own settings
      // Admin can read any settings
      allow read: if isActiveAdmin()
        || (isActiveUser() && request.auth.uid == uid);

      // Update: User can update their own settings
      // Admin can update any settings
      allow update: if isActiveAdmin()
        || (isActiveUser()
          && request.auth.uid == uid
          && request.resource.data.userId == request.auth.uid);

      // Delete: User can delete their own settings
      // Admin can delete any settings
      allow delete: if isActiveAdmin()
        || (isActiveUser() && request.auth.uid == uid);
    }
  }
}
